{
  "name": "pulsar-assistant",
  "main": "./lib/main.js",
  "version": "0.5.3",
  "description": "Coding agent for Pulsar",
  "keywords": [ "acp", "agent", "ai", "assistant", "chatgpt", "gpt", "llm" ],
  "license": "MIT",
  "engines": {
    "atom": ">=1.130.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Psychosynthesis/PulsarAssistant.git"
  },
  "homepage": "https://github.com/Psychosynthesis/PulsarAssistant#readme",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "styles",
    "LICENSE",
    "README.md"
  ],
  "activationCommands": {
    "atom-workspace": [
      "pulsar-assistant:open-for-project",
      "pulsar-assistant:toggle",
      "pulsar-assistant:focus",
      "pulsar-assistant:edit-agents",
      "pulsar-assistant:manage-projects"
    ],
    ".tree-view": [
      "pulsar-assistant:open-for-project"
    ],
    "atom-text-editor": [
      "pulsar-assistant:add-active-file-to-prompt",
      "pulsar-assistant:add-selection-to-prompt"
    ]
  },
  "deserializers": {
    "PulsarAssistantView": "deserializePulsarAssistantView"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepare": "git config core.hooksPath ./.github/.hooks || echo 'Not in a git repo'"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@types/atom": "npm:@pulsar-edit/types@^1.130.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.0",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.0",
    "marked": "^18.0.5",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "configSchema": {
    "sendHostContext": {
      "type": "boolean",
      "default": true,
      "order": 2,
      "title": "Send host context",
      "description": "Tell the agent once per session that it is connected through Pulsar Assistant inside Pulsar. This helps agents answer accurately about what they can and cannot do in the editor."
    },
    "modelContextWindows": {
      "type": "object",
      "default": {},
      "order": 3,
      "title": "Model Context Windows",
      "description": "Custom context window limits in tokens. Map a model name or family prefix to a positive integer, for example: modelContextWindows: { \"my-custom-model\": 32768, \"gpt-5.1\": 128000 }."
    },
    "ignoredDirectories": {
      "type": "array",
      "default": [
        ".git",
        "node_modules",
        "dist",
        "build",
        "out",
        "target",
        ".venv",
        "venv",
        "coverage",
        ".idea",
        ".vscode"
      ],
      "items": {
        "type": "string"
      },
      "order": 4,
      "title": "Ignored Directories",
      "description": "Directory names to ignore when searching with grep/glob and indexing files for the project file tree (B-tree)."
    }
  }
}
