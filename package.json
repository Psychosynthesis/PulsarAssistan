{
  "name": "pulsar-assistant",
  "main": "./lib/main.js",
  "version": "0.3.0",
  "description": "Coding agent for Pulsar",
  "keywords": [ "acp", "agent", "ai", "assistant" ],
  "license": "MIT",
  "engines": {
    "atom": ">=1.130.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Psychosynthesis/PulsarAssistan.git"
  },
  "homepage": "https://github.com/Psychosynthesis/PulsarAssistan#readme",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "styles",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "activationCommands": {
    "atom-workspace": [
      "pulsar-assistant:open-for-project",
      "pulsar-assistant:toggle",
      "pulsar-assistant:focus",
      "pulsar-assistant:edit-agents"
    ],
    ".tree-view": [
      "pulsar-assistant:open-for-project"
    ],
    "atom-text-editor": [
      "pulsar-assistant:add-active-file-to-prompt",
      "pulsar-assistant:add-selection-to-prompt"
    ]
  },
  "deserializers": {
    "PulsarAssistantView": "deserializePulsarAssistantView"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@types/atom": "npm:@pulsar-edit/types@^1.130.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.0",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.0",
    "marked": "^18.0.5",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "configSchema": {
    "sendHostContext": {
      "type": "boolean",
      "default": true,
      "order": 2,
      "title": "Send host context",
      "description": "Tell the agent once per session that it is connected through Pulsar Assistant inside Pulsar. This helps agents answer accurately about what they can and cannot do in the editor."
    }
  }
}
