#!/usr/bin/env bash
set -euo pipefail

echo "Run precommit hook"

npm run typecheck
npm run build
npm run test -- --test-reporter=dot

# -------------------------------------------------------------------
# Проверка пробелов в именах файлов внутри src
# -------------------------------------------------------------------

files_with_spaces=()

while IFS= read -r -d '' file; do
  if [[ "$file" == src/* && "$file" == *" "* ]]; then
    files_with_spaces+=("$file")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if ((${#files_with_spaces[@]} > 0)); then
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  echo "Ошибка: в именах файлов внутри src обнаружены пробелы:"
  printf '  - %s\n' "${files_with_spaces[@]}"
  echo "Переименуй файлы без пробелов и попробуй снова."
  exit 1
fi
